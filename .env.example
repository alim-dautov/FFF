# Ключ xAI / Grok. Только сервер. Не класть в клиентский код.
GROK_API_KEY=
GROK_MODEL=grok-4

# sqlite (по умолчанию) или mysql на hoster.kz
DB_DRIVER=sqlite
SQLITE_PATH=

# MySQL, если DB_DRIVER=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=foodforfit
MYSQL_USER=
MYSQL_PASSWORD=

# WhatsApp Cloud API. Пустые значения оставляют сообщения черновиками.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Kaspi. Пока ключ пустой, провайдер не вызывается.
KASPI_API_KEY=
KASPI_WEBHOOK_SECRET=

# Web Push. Без ключей работают только уведомления внутри CRM.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@foodforfit.kz

APP_URL=http://localhost:5173
APP_DEBUG=1
